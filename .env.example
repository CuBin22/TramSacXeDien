# Sao chép thành .env rồi sửa giá trị
DB_NAME=tramsac
DB_USER=tramsac
DB_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự (dùng ký JWT từ Task 5)
JWT_SECRET=doi-chuoi-bi-mat-dai-it-nhat-32-ky-tu
# Cổng trên máy bạn để xem CSDL bằng DBeaver/pgAdmin (trong Docker vẫn là 5432)
DB_HOST_PORT=5433
# Profile dev nạp 4 tài khoản mẫu (mật khẩu Demo1234). Đặt giá trị khác (ví dụ prod) để tắt.
SPRING_PROFILES_ACTIVE=dev
COMPOSE_PROFILES=dev
# MQTT và device-sim chỉ dùng trong profile dev; đổi mật khẩu mẫu trước khi chạy.
MQTT_USER=tramsac
MQTT_PASSWORD=doi-mat-khau-mqtt
MQTT_HOST_PORT=1883
# Dùng chung giữa app và payment-sim; thay hai giá trị mẫu trước khi chạy.
PAYMENT_SIM_API_TOKEN=doi-token-payment-sim-dai-it-nhat-32-ky-tu
PAYMENT_WEBHOOK_SECRET=doi-bi-mat-webhook-thanh-toan-dai-it-nhat-32-ky-tu
PAYMENT_SIM_HOST_PORT=8091
